# NetraVerse Passive Monitoring Dashboard Configuration
# Specify the path to the SQLite database written by the C++ monitoring process.
# In local development, if unset, defaults to ../sql_lite/netraverse_dev.db
SQLITE_DB_PATH=../sql_lite/netraverse_dev.db

# Monitoring data freshness threshold in seconds (default: 60)
# If service_metrics is not updated within this window, the service is flagged as stale/offline.
METRICS_FRESHNESS_SECONDS=60
